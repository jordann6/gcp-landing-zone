# Copy to terraform.tfvars and fill in. Gitignored: both values identify real
# billing and org resources.

# gcloud organizations list
org_id = "000000000000"

# gcloud billing accounts list
billing_account = "000000-000000-000000"

# Set true only for the final teardown.
force_destroy_state = false

# Who may impersonate sa-terraform. Every later root applies as that account.
operators = ["user:you@example.com"]
